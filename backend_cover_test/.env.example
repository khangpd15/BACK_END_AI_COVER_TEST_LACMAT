# Environment Mode (development / production)
APP_ENV=development

# Server Port
PORT=8001

# CORS Origins (Comma-separated)
REMICARE_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Supabase PostgreSQL / Connection Pooler)
# Note: Use Supavisor IPv4 Pooler (port 6543) for Render deployment:
# postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./cover_test.db

# Supabase Storage Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET_RAW=cover-test-raw

# AI Inference Execution Flag
ENABLE_AI_INFERENCE_ON_SAVE=true

# Keep-Alive Configuration
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_SECONDS=600
KEEP_ALIVE_PING_DB=true
RENDER_EXTERNAL_URL=
