# RemiCare Cover Test AI Backend Configuration
APP_ENV=development
PORT=8000
REMICARE_FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,https://remicare.id.vn,https://www.remicare.id.vn,https://cover-test.remicare.id.vn

# Database Configuration (Optional: defaults to SQLite at data/cover_test.db)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres

# Storage Configuration
LOCAL_STORAGE_DIR=data/cover-test-raw

# AI & Performance Settings
ENABLE_AI_INFERENCE_ON_SAVE=true
KEEP_ALIVE_ENABLED=false
ENABLE_LEGACY_SCHEMA_CLEANUP=false
